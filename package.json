{
  "name": "coveru",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:data-pipeline": "vitest run src/lib/data-pipeline",
    "validate:migrations": "vitest run src/lib/migrations",
    "test:migrations:ephemeral": "node scripts/test-migrations-ephemeral.mjs",
    "test:e2e": "playwright test e2e/smoke/public.spec.ts e2e/smoke/marketplace.spec.ts e2e/smoke/coverage-assistant.spec.ts",
    "test:e2e:preview": "playwright test e2e/smoke/preview.spec.ts",
    "test:a11y": "playwright test e2e/a11y",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run validate:migrations && npm run test:data-pipeline && npm run build && npm run test:e2e && npm run test:a11y",
    "integrate:visual-pack": "bash scripts/integrate-sam-visual-pack.sh",
    "catalog:load": "tsx scripts/catalog-v1_3/load-cli.ts",
    "catalog:load:dry-run": "tsx scripts/catalog-v1_3/load-cli.ts --dry-run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.114.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
