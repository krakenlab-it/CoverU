# Supabase — required for production persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose in client code or commit real values
SUPABASE_SERVICE_ROLE_KEY=

# API key hashing pepper (server-only)
API_KEY_PEPPER=

# Rate limiting (requests per window per API key)
API_RATE_LIMIT=100
API_RATE_WINDOW_MS=60000

# Coverage Q&A provider: demo (default) or openai
COVERAGE_QA_PROVIDER=demo
OPENAI_API_KEY=
COVERAGE_QA_MODEL=gpt-4o-mini

# Public marketing — WhatsApp link for header CTA and FAB (wa.me format)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/593XXXXXXXXX
