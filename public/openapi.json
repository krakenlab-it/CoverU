{
  "openapi": "3.1.0",
  "info": {
    "title": "CoverÜ API",
    "version": "1.0.0",
    "description": "API B2B de CoverÜ para catálogo de seguros de salud, cotizaciones y consultas de cobertura fundamentadas en el texto de póliza.",
    "contact": {
      "name": "KrakenLab — CoverÜ",
      "url": "https://github.com/krakenlab-it/CoverU"
    }
  },
  "servers": [
    {
      "url": "https://cover-u-app.vercel.app/api/v1",
      "description": "Producción"
    },
    {
      "url": "/api/v1",
      "description": "Relativa al dominio de despliegue"
    }
  ],
  "security": [
    { "ApiKeyAuth": [] },
    { "BearerAuth": [] }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Clave API B2B. También acepta Authorization: Bearer <key>."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clave API como token Bearer."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {}
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "total_pages": { "type": "integer" }
        }
      },
      "Insurer": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "logo_url": { "type": "string", "nullable": true },
          "is_demo": { "type": "boolean" }
        }
      },
      "Plan": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "insurer_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "coverage_summary": { "type": "string", "nullable": true },
          "natural_key_plan_id": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["active", "inactive", "archived"] },
          "is_demo": { "type": "boolean" }
        }
      },
      "PlanVersion": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_id": { "type": "string", "format": "uuid" },
          "version_number": { "type": "integer" },
          "label": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["draft", "published", "archived"] },
          "effective_from": { "type": "string", "format": "date", "nullable": true },
          "effective_to": { "type": "string", "format": "date", "nullable": true },
          "published_at": { "type": "string", "format": "date-time", "nullable": true },
          "is_demo": { "type": "boolean" }
        }
      },
      "Tariff": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid", "nullable": true },
          "age_min": { "type": "integer" },
          "age_max": { "type": "integer" },
          "gender": {
            "type": "string",
            "enum": ["any", "femenino", "masculino"]
          },
          "region": {
            "type": "string",
            "enum": ["Nacional", "Austro", "Costa", "Sierra"]
          },
          "grupo_asegurado": {
            "type": "string",
            "enum": ["titular", "nino_solo"],
            "nullable": true
          },
          "monthly_price": {
            "type": "number",
            "description": "USD monthly premium tax-included (prima_mensual_con_imp). Dollars, not cents."
          },
          "deductible": { "type": "integer", "nullable": true },
          "copay_pct": { "type": "integer", "nullable": true },
          "annual_limit": { "type": "integer", "nullable": true },
          "maternidad": {
            "type": "string",
            "enum": ["Si", "No"],
            "nullable": true
          },
          "tax_included": { "type": "boolean", "nullable": true },
          "is_demo": { "type": "boolean" }
        }
      },
      "Quote": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "organization_id": { "type": "string", "format": "uuid", "nullable": true },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "tariff_version_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "KAN-231: fila exacta de tariffs usada para cotizar. Null en cotizaciones anteriores a la migración."
          },
          "plan_conditions_version_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "KAN-231: versión de plan cuyas condiciones (deducibles, coaseguro, copagos, modalidad de pago, techos) se cotizaron. Null en cotizaciones anteriores a la migración."
          },
          "external_ref": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "monthly_price": {
            "type": "number",
            "nullable": true,
            "description": "USD monthly premium snapshot. Dollars, not cents."
          },
          "is_demo": { "type": "boolean" }
        }
      },
      "QuoteCreateRequest": {
        "type": "object",
        "required": ["plan_version_id", "age"],
        "properties": {
          "plan_version_id": { "type": "string", "format": "uuid" },
          "age": { "type": "integer", "minimum": 0, "maximum": 120 },
          "gender": {
            "type": "string",
            "enum": ["any", "femenino", "masculino"]
          },
          "region": {
            "type": "string",
            "enum": ["Nacional", "Austro", "Costa", "Sierra"]
          },
          "grupo_asegurado": {
            "type": "string",
            "enum": ["titular", "nino_solo"]
          },
          "external_ref": { "type": "string", "maxLength": 120 },
          "expires_at": { "type": "string", "format": "date-time" },
          "requote_of": {
            "type": "string",
            "format": "uuid",
            "description": "Cotización activa o expirada del mismo tenant que se recalcula contra el catálogo actual."
          }
        }
      },
      "QuoteVersions": {
        "type": "object",
        "description": "KAN-231: referencias de versión guardadas en la cotización.",
        "required": ["plan_version_id"],
        "properties": {
          "plan_version_id": { "type": "string", "format": "uuid" },
          "plan_conditions_version_id": { "type": "string", "format": "uuid", "nullable": true },
          "tariff_version_id": { "type": "string", "format": "uuid", "nullable": true }
        }
      },
      "QuoteVersionChange": {
        "type": "object",
        "description": "KAN-231: diferencia entre la cotización anterior y el catálogo actual al recotizar.",
        "properties": {
          "changed": { "type": "boolean" },
          "tariff_changed": { "type": "boolean" },
          "conditions_changed": { "type": "boolean" },
          "price_changed": { "type": "boolean" },
          "previous": { "$ref": "#/components/schemas/QuoteVersionSnapshot" },
          "next": { "$ref": "#/components/schemas/QuoteVersionSnapshot" }
        }
      },
      "QuoteVersionSnapshot": {
        "type": "object",
        "properties": {
          "tariffVersionId": { "type": "string", "format": "uuid", "nullable": true },
          "conditionsVersionId": { "type": "string", "format": "uuid", "nullable": true },
          "monthlyPrice": {
            "type": "number",
            "nullable": true,
            "description": "USD monthly premium. Dollars, not cents."
          }
        }
      },
      "ConditionsVersion": {
        "type": "object",
        "description": "KAN-231: versión de condiciones asociada a una versión de plan.",
        "properties": {
          "plan_conditions_version_id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "condition_counts": {
            "type": "object",
            "properties": {
              "deductibles": { "type": "integer" },
              "coinsurance": { "type": "integer" },
              "copays": { "type": "integer" },
              "paymentModalities": { "type": "integer" },
              "ceilings": { "type": "integer" },
              "total": { "type": "integer" }
            }
          }
        }
      },
      "CoverageQaRequest": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "plan_version_id": { "type": "string", "format": "uuid" },
          "plan_id": { "type": "string", "format": "uuid" },
          "question": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "history": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": ["question"],
              "properties": {
                "question": { "type": "string", "minLength": 3, "maxLength": 1000 }
              }
            }
          }
        }
      },
      "MatchedTariffSnapshot": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "age_min": { "type": "integer" },
          "age_max": { "type": "integer" },
          "gender": { "type": "string" },
          "region": { "type": "string" },
          "grupo_asegurado": { "type": "string", "nullable": true },
          "maternidad": { "type": "string", "nullable": true },
          "deductible": { "type": "number", "nullable": true },
          "annual_limit": { "type": "number", "nullable": true },
          "monthly_price": {
            "type": "number",
            "description": "USD monthly premium. Dollars, not cents."
          },
          "tax_included": { "type": "boolean", "nullable": true }
        }
      },
      "CoverageQaResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["covered", "not_covered", "conditional", "unknown", "quoted"]
          },
          "answer": { "type": "string" },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clause_ref": { "type": "string" },
                "excerpt": { "type": "string" },
                "page_number": { "type": "integer", "nullable": true },
                "policy_document_title": { "type": "string" }
              }
            }
          },
          "matched_tariff": {
            "nullable": true,
            "allOf": [{ "$ref": "#/components/schemas/MatchedTariffSnapshot" }]
          },
          "abstained": { "type": "boolean" },
          "policy_wording_controls": { "type": "boolean" },
          "provider": { "type": "string" },
          "run": {
            "type": "object",
            "description": "Harness trace: status, tools, and duration.",
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string" },
              "duration_ms": { "type": "integer" },
              "intent": { "type": "string", "nullable": true },
              "provider": { "type": "string" },
              "tools": { "type": "array" }
            }
          }
        }
      },
      "PlanConditions": {
        "type": "object",
        "description": "Condiciones del plan versionadas con plan_versions y congeladas al publicarse la versión. Montos en USD (dólares, no centavos).",
        "properties": {
          "deductibles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanDeductible" }
          },
          "coinsurance": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanCoinsurance" }
          },
          "copays": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanCopay" }
          },
          "paymentModalities": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanPaymentModality" }
          },
          "ceilings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PlanCoverageCeiling" }
          }
        }
      },
      "PlanDeductible": {
        "type": "object",
        "required": ["id", "plan_version_id", "scope", "basis", "amount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "scope": { "type": "string", "enum": ["individual", "familiar"] },
          "basis": {
            "type": "string",
            "enum": ["por_evento", "por_anio", "por_ingreso", "vitalicio"]
          },
          "amount": { "type": "number", "minimum": 0, "description": "USD" },
          "notes": { "type": "string", "nullable": true },
          "sort_order": { "type": "integer" }
        }
      },
      "PlanCoinsurance": {
        "type": "object",
        "required": ["id", "plan_version_id", "network", "insurer_pct", "insured_pct"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "network": { "type": "string", "enum": ["en_red", "fuera_de_red"] },
          "insurer_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "insured_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "insurer_pct + insured_pct = 100"
          },
          "service_category": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "sort_order": { "type": "integer" }
        }
      },
      "PlanCopay": {
        "type": "object",
        "required": ["id", "plan_version_id", "service_category", "network", "amount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "service_category": { "type": "string" },
          "network": { "type": "string", "enum": ["en_red", "fuera_de_red"] },
          "amount": { "type": "number", "minimum": 0, "description": "USD" },
          "notes": { "type": "string", "nullable": true },
          "sort_order": { "type": "integer" }
        }
      },
      "PlanPaymentModality": {
        "type": "object",
        "required": ["id", "plan_version_id", "method", "frequency", "is_default"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "method": {
            "type": "string",
            "enum": ["debito", "tarjeta_credito", "transferencia", "efectivo", "otro"]
          },
          "frequency": {
            "type": "string",
            "enum": ["mensual", "trimestral", "semestral", "anual"]
          },
          "is_default": {
            "type": "boolean",
            "description": "Como máximo una modalidad predeterminada por versión"
          },
          "payment_url": { "type": "string", "nullable": true, "format": "uri" },
          "notes": { "type": "string", "nullable": true },
          "sort_order": { "type": "integer" }
        }
      },
      "PlanCoverageCeiling": {
        "type": "object",
        "required": ["id", "plan_version_id", "scope", "amount"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "plan_version_id": { "type": "string", "format": "uuid" },
          "scope": {
            "type": "string",
            "enum": ["por_persona", "por_familia", "por_evento", "por_anio", "vitalicio"]
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "USD"
          },
          "service_category": { "type": "string", "nullable": true },
          "notes": { "type": "string", "nullable": true },
          "sort_order": { "type": "integer" }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "API key ausente o inválida",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RateLimited": {
        "description": "Límite de solicitudes excedido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  },
  "paths": {
    "/insurers": {
      "get": {
        "summary": "Listar aseguradoras",
        "operationId": "listInsurers",
        "tags": ["Catálogo"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "is_demo", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada de aseguradoras",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "insurers": { "type": "array", "items": { "$ref": "#/components/schemas/Insurer" } },
                        "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                      }
                    },
                    "request_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/plans": {
      "get": {
        "summary": "Listar planes",
        "operationId": "listPlans",
        "tags": ["Catálogo"],
        "parameters": [
          { "name": "insurer_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "status", "in": "query", "schema": { "type": "string", "default": "active" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Lista paginada de planes" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/plan-versions": {
      "get": {
        "summary": "Detalle de versión de plan",
        "description": "Devuelve la versión publicada con cláusulas, exclusiones, carencias, documentos, citas y condiciones del plan (deducibles, coaseguro, copagos, modalidad de pago y techos de cobertura).",
        "operationId": "getPlanVersion",
        "tags": ["Catálogo"],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Detalle con cláusulas, exclusiones, carencias y condiciones del plan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "plan_conditions": { "$ref": "#/components/schemas/PlanConditions" },
                        "conditions_version": { "$ref": "#/components/schemas/ConditionsVersion" }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Versión no encontrada" }
        }
      }
    },
    "/tariffs": {
      "get": {
        "summary": "Listar tarifas",
        "operationId": "listTariffs",
        "tags": ["Catálogo"],
        "parameters": [
          { "name": "plan_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "region", "in": "query", "schema": { "type": "string" } },
          { "name": "gender", "in": "query", "schema": { "type": "string" } },
          { "name": "age", "in": "query", "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": { "description": "Lista paginada de tarifas" }
        }
      }
    },
    "/quotes": {
      "get": {
        "summary": "Consultar cotización",
        "operationId": "getQuote",
        "tags": ["Cotizaciones"],
        "parameters": [
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Cotización encontrada" },
          "403": { "description": "Sin acceso a la cotización" },
          "404": { "description": "Cotización no encontrada" }
        }
      },
      "post": {
        "summary": "Crear cotización con versión de tarifa y condiciones",
        "operationId": "createQuote",
        "tags": ["Cotizaciones"],
        "description": "Crea una cotización fijando la fila de tarifa y la versión de condiciones usadas. Requiere el scope write:quotes. Con requote_of se recalcula contra el catálogo actual y la nueva fila registra la versión anterior; la cotización original nunca se modifica.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/QuoteCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cotización creada con sus versiones fijadas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "quote": { "$ref": "#/components/schemas/Quote" },
                        "versions": { "$ref": "#/components/schemas/QuoteVersions" },
                        "re_quote": {
                          "nullable": true,
                          "allOf": [{ "$ref": "#/components/schemas/QuoteVersionChange" }]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Parámetros inválidos" },
          "404": { "description": "Versión de plan, cotización original o tarifa no encontrada" },
          "422": { "description": "No hay tarifa vigente para edad, género y región" }
        }
      }
    },
    "/coverage/qa": {
      "post": {
        "summary": "Pregunta de cobertura fundamentada",
        "operationId": "coverageQa",
        "tags": ["Cobertura"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CoverageQaRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta fundamentada con citas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/CoverageQaResponse" }
                  }
                }
              }
            }
          },
          "404": { "description": "Versión de plan no encontrada" }
        }
      }
    }
  },
  "tags": [
    { "name": "Catálogo", "description": "Aseguradoras, planes, versiones y tarifas" },
    { "name": "Cotizaciones", "description": "Consulta de cotizaciones B2B" },
    { "name": "Cobertura", "description": "Preguntas de cobertura con citas de póliza" }
  ],
  "x-rate-limits": {
    "default": {
      "limit": 100,
      "window_seconds": 60,
      "headers": ["X-RateLimit-Limit", "X-RateLimit-Remaining"]
    }
  }
}
